+struct PostProjectSidecar::ProxyJob::Claim
+{
+    QString sidecar;
+    pp::Production production;
+    pp::AssetId assetId;
+    pp::RepresentationId sourceId;
+    QString sourcePath;
+    pp::JobId jobId;
+    pp::JobLease lease;
+    std::int64_t startedAt;
+};
