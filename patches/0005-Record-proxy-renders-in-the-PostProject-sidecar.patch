  */
 void recordProject(const QString &projectPath, const QDomDocument &scene);
 
+/**
+ * @brief One proxy render, recorded through PostProject's job protocol with
+ * Kdenlive as the worker.
+ *
+ * Construction requests a proxy job for a clip recorded in the sidecar and
+ * claims it. Succeeding records the proxy as a representation of the clip
+ * together with the render activity; failing records the diagnostic. A job left
+ * unfinished is cancelled. Without a sidecar that knows the clip the job is
+ * inactive and every call does nothing.
+ */
+class ProxyJob
+{
+public:
+    ProxyJob(const QString &projectPath, const QString &controlUuid, const QString &sourcePath);
+    ~ProxyJob();
+    ProxyJob(const ProxyJob &) = delete;
+    ProxyJob &operator=(const ProxyJob &) = delete;
+
+    bool isActive() const;
+    /** @brief Waits for a render process, renewing the claim while it runs. */
+    void waitForFinished(QProcess &process);
+    /**
+     * @param tool the program that rendered the proxy
+     * @param arguments its arguments; the source and proxy paths are recorded as
+     *        {source} and {proxy}
+     */
+    void succeed(const QString &proxyPath, const QString &tool, const QStringList &arguments);
+    void fail(const QString &diagnostic);
+
+private:
+    struct Claim;
+    std::unique_ptr<Claim> m_claim;
+};
