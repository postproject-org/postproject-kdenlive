+// Records proxies that Kdenlive made while their clip was not yet recorded, such
+// as every proxy of a project saved for the first time. Kdenlive names a proxy
+// after its source's hash, so a proxy named after the clip's present hash was
+// made from the clip's present content. No render was observed, so the
+// activity names neither the tool nor its arguments.
+pp::Result<bool> stageAdoptedProxies(const pp::ReadSession &production, pp::Transaction &transaction, const std::vector<BinClip> &clips)
+{
+    bool changed = false;
+    for (const BinClip &clip : clips) {
+        if (clip.proxy.isEmpty() || clip.hash.isEmpty() || QFileInfo(clip.proxy).completeBaseName().toLatin1() != clip.hash.toHex()) {
+            continue;
+        }
+        POSTPROJECT_TRY_ASSIGN(const std::optional<pp::AssetId> assetId, findClipAsset(production, clip.controlUuid));
+        if (!assetId) {
+            continue;
+        }
+        POSTPROJECT_TRY_ASSIGN(const std::vector<pp::Representation> representations, representationsForClip(production, *assetId));
+        const std::optional<pp::Representation> source = clipRepresentation(representations);
+        if (!source || proxyAt(representations, locatorFor(clip.proxy)) || ProjectClip::calculateHash(clip.path).first != clip.hash) {
+            continue;
+        }
+        // Observing unchanged content records nothing.
+        POSTPROJECT_TRY(transaction.observeResourceContent(source->resources.front().id, utf8(clip.path)));
+        pp::ActivitySpec activity;
+        activity.kind = ProxyJobKind;
+        activity.inputs = {source->id};
+        POSTPROJECT_TRY(transaction.registerOutputs({{utf8(clip.proxy), *assetId, pp::RepresentationKind::proxy, std::nullopt, std::nullopt}}, activity));
+        changed = true;
+    }
+    return changed;
+}
