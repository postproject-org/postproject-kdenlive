+PostProjectSidecar::ProxyJob::ProxyJob(const QString &projectPath, const QString &controlUuid, const QString &sourcePath)
+{
+    // An unsaved project has no sidecar.
+    const QString sidecar = projectPath.isEmpty() ? QString() : sidecarPath(projectPath);
+    if (sidecar.isEmpty() || controlUuid.isEmpty() || !QFileInfo::exists(sidecar)) {
+        return;
+    }
+    const pp::Result<void> claimed = [&]() -> pp::Result<void> {
+        POSTPROJECT_TRY_ASSIGN(pp::Production production, pp::Production::open(utf8(sidecar)));
+        POSTPROJECT_TRY_ASSIGN(const std::optional<pp::AssetId> assetId, findClipAsset(production, utf8(controlUuid)));
+        if (!assetId) {
+            return {};
+        }
+        POSTPROJECT_TRY_ASSIGN(const std::optional<pp::Representation> source, clipRepresentation(production, *assetId));
+        if (!source) {
+            return {};
+        }
+        const std::int64_t now = nowMicros();
+        // The transaction must end before the production moves into the claim.
+        std::optional<pp::JobId> jobId;
+        std::optional<pp::Uuid> claimId;
+        {
+            POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, production.beginTransaction());
+            POSTPROJECT_TRY(transaction.setRevisionContext(revisionContext("Create proxy clip")));
+            // The proxy is made from the source as it is now. Observing unchanged
+            // content records nothing.
+            POSTPROJECT_TRY(transaction.observeResourceContent(source->resources.front().id, utf8(sourcePath)));
+            POSTPROJECT_TRY_ASSIGN(jobId, transaction.requestJob({ProxyJobKind, {source->id}, *assetId, pp::RepresentationKind::proxy, std::nullopt}));
+            POSTPROJECT_TRY_ASSIGN(claimId, transaction.claimJob(*jobId, kdenliveTool(), std::nullopt, now, now + ClaimLeaseMicros));
+            POSTPROJECT_TRY(transaction.commit());
+        }
+        m_claim.reset(new Claim{sidecar, std::move(production), *assetId, source->id, sourcePath, *jobId, *claimId, now});
+        return {};
+    }();
+    if (!claimed.has_value()) {
+        logFailure(sidecar, "could not start a proxy job", claimed.error());
+    }
+}
+
+PostProjectSidecar::ProxyJob::~ProxyJob()
+{
+    if (!m_claim) {
+        return;
+    }
+    // The render was abandoned, for example cancelled by the user.
+    const pp::Result<void> cancelled = [&]() -> pp::Result<void> {
+        POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, m_claim->production.beginTransaction());
+        POSTPROJECT_TRY(transaction.setRevisionContext(revisionContext("Cancel proxy clip")));
+        POSTPROJECT_TRY(transaction.cancelJob(m_claim->jobId));
+        return transaction.commit();
+    }();
+    if (!cancelled.has_value()) {
+        logFailure(m_claim->sidecar, "could not cancel a proxy job", cancelled.error());
+    }
+}
+
+bool PostProjectSidecar::ProxyJob::isActive() const
+{
+    return m_claim != nullptr;
+}
+
+void PostProjectSidecar::ProxyJob::waitForFinished(QProcess &process)
+{
+    if (!m_claim) {
+        process.waitForFinished(-1);
+        return;
+    }
+    while (!process.waitForFinished(ClaimRenewalMillis) && process.state() != QProcess::NotRunning) {
+        const pp::Result<void> renewed = [&]() -> pp::Result<void> {
+            const std::int64_t now = nowMicros();
+            POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, m_claim->production.beginTransaction());
+            POSTPROJECT_TRY(transaction.renewJobClaim(m_claim->jobId, m_claim->claimId, now, now + ClaimLeaseMicros));
+            return transaction.commit();
+        }();
+        if (!renewed.has_value()) {
+            logFailure(m_claim->sidecar, "could not renew a proxy job", renewed.error());
+        }
+    }
+}
+
+void PostProjectSidecar::ProxyJob::succeed(const QString &proxyPath, const QString &tool, const QStringList &arguments)
+{
+    if (!m_claim) {
+        return;
+    }
+    Claim &claim = *m_claim;
+    const pp::Result<void> completed = [&]() -> pp::Result<void> {
+        const std::string proxyLocator = locatorFor(proxyPath);
+        POSTPROJECT_TRY_ASSIGN(const std::vector<pp::Representation> representations, claim.production.representations(claim.assetId));
+        const std::int64_t now = nowMicros();
+        POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, claim.production.beginTransaction());
+        POSTPROJECT_TRY(transaction.setRevisionContext(revisionContext("Create proxy clip")));
+        // A proxy rendered over an older one: the older proxy's content is gone.
+        for (const pp::Representation &representation : representations) {
+            if (representation.kind != pp::RepresentationKind::proxy) {
+                continue;
+            }
+            for (const pp::Resource &resource : representation.resources) {
+                for (const pp::Locator &locator : resource.locators) {
+                    if (locator.uri == proxyLocator) {
+                        POSTPROJECT_TRY(transaction.retireLocator(locator.id));
+                    }
+                }
+            }
+        }
+        POSTPROJECT_TRY_ASSIGN(const pp::RepresentationId proxyId, transaction.addSingleFileRepresentation(claim.assetId, pp::RepresentationKind::proxy, utf8(proxyPath)));
+        pp::ActivitySpec activity;
+        activity.kind = ProxyJobKind;
+        activity.started_at_unix_micros = claim.startedAt;
+        activity.finished_at_unix_micros = now;
+        activity.tool = pp::ToolIdentity{utf8(QFileInfo(tool).fileName()), std::nullopt, std::nullopt};
+        activity.inputs = {{claim.sourceId, std::nullopt}};
+        activity.outputs = {{proxyId, std::nullopt}};
+        POSTPROJECT_TRY_ASSIGN(const pp::ActivityId activityId, transaction.createActivity(activity));
+        // The arguments are the render's parameters. Machine-local paths are
+        // replaced, so the activity is enough to render the proxy again.
+        std::vector<pp::MetadataValue> values;
+        for (QString argument : arguments) {
+            argument.replace(claim.sourcePath, QStringLiteral("{source}")).replace(proxyPath, QStringLiteral("{proxy}"));
+            values.push_back(pp::MetadataValue::plainString(utf8(argument)));
+        }
+        POSTPROJECT_TRY(
+            transaction.addMetadataValue(pp::ObjectRef::activity(activityId), ProxyVocabulary, "arguments", pp::MetadataValue::list(std::move(values))));
+        POSTPROJECT_TRY(transaction.completeJob(claim.jobId, claim.claimId, now, proxyId, activityId));
+        return transaction.commit();
+    }();
+    if (!completed.has_value()) {
+        logFailure(claim.sidecar, "could not record a proxy", completed.error());
+        fail(fromUtf8(completed.error().message()));
+        return;
+    }
+    m_claim.reset();
+}
+
+void PostProjectSidecar::ProxyJob::fail(const QString &diagnostic)
+{
+    if (!m_claim) {
+        return;
+    }
+    const pp::Result<void> failed = [&]() -> pp::Result<void> {
+        POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, m_claim->production.beginTransaction());
+        POSTPROJECT_TRY(transaction.setRevisionContext(revisionContext("Create proxy clip")));
+        POSTPROJECT_TRY(transaction.failJob(m_claim->jobId, m_claim->claimId, nowMicros(), failureDiagnostic(diagnostic)));
+        return transaction.commit();
+    }();
+    if (failed.has_value()) {
+        m_claim.reset();
+    } else {
+        // The destructor cancels the job instead.
+        logFailure(m_claim->sidecar, "could not record a failed proxy job", failed.error());
+    }
+}
