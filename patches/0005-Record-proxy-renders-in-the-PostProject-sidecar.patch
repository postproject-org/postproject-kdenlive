+// The end of a render log, within PostProject's bound for a failure diagnostic.
+std::string failureDiagnostic(const QString &log)
+{
+    constexpr qsizetype MaxBytes = 4096;
+    QByteArray diagnostic = log.trimmed().toUtf8().replace('\0', ' ');
+    if (diagnostic.size() > MaxBytes) {
+        qsizetype start = diagnostic.size() - MaxBytes;
+        while (start < diagnostic.size() && (diagnostic.at(start) & 0xC0) == 0x80) {
+            ++start;
+        }
+        diagnostic = diagnostic.mid(start);
+    }
+    return diagnostic.isEmpty() ? std::string("Proxy render failed") : diagnostic.toStdString();
+}
