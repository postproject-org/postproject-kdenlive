+// The clip's proxy representation whose file is at a locator.
+std::optional<pp::Representation> proxyAt(const std::vector<pp::Representation> &representations, const std::string &locator)
+{
+    for (const pp::Representation &representation : representations) {
+        if (representation.kind != pp::RepresentationKind::proxy || representation.resources.size() != 1) {
+            continue;
+        }
+        for (const pp::Locator &known : representation.resources.front().locators) {
+            if (known.uri == locator) {
+                return representation;
+            }
+        }
+    }
+    return std::nullopt;
+}
