diff --git a/tests/postprojecttest.cpp b/tests/postprojecttest.cpp
index 5625ff18f..298a02bee 100644
--- a/tests/postprojecttest.cpp
+++ b/tests/postprojecttest.cpp
@@ -331,6 +331,19 @@ TEST_CASE("Relink missing clips through a PostProject sidecar", "[PostProject]")
     }
 }
 
+TEST_CASE("Select an explicit shared PostProject production", "[PostProject]")
+{
+    QTemporaryDir projectFolder;
+    REQUIRE(projectFolder.isValid());
+    const QString projectPath = projectFolder.filePath(QStringLiteral("film.kdenlive"));
+    const QString sharedPath = projectFolder.filePath(QStringLiteral("shared/documentary.pproj"));
+
+    qApp->setProperty("postprojectProductionPath", sharedPath);
+    CHECK(PostProjectSidecar::sidecarPath(projectPath) == QFileInfo(sharedPath).absoluteFilePath());
+    qApp->setProperty("postprojectProductionPath", QString());
+    CHECK(PostProjectSidecar::sidecarPath(projectPath) == projectFolder.filePath(QStringLiteral("film.pproj")));
+}
+
