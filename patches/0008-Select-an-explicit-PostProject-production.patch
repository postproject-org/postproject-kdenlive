diff --git a/src/doc/postprojectsidecar.cpp b/src/doc/postprojectsidecar.cpp
index 225ad08f8..9c3b90121 100644
--- a/src/doc/postprojectsidecar.cpp
+++ b/src/doc/postprojectsidecar.cpp
@@ -11,6 +11,7 @@
 #include "xml/xml.hpp"
 #include <config-kdenlive.h>
 
+#include <QCoreApplication>
 #include <QDateTime>
 #include <QDir>
 #include <QDomDocument>
@@ -485,6 +486,12 @@ struct PostProjectSidecar::ProxyJob::Claim
 
 QString PostProjectSidecar::sidecarPath(const QString &projectPath)
 {
+    if (QCoreApplication::instance() != nullptr) {
+        const QString selected = QCoreApplication::instance()->property("postprojectProductionPath").toString();
+        if (!selected.isEmpty()) {
+            return QFileInfo(selected).absoluteFilePath();
+        }
+    }
     const QFileInfo project(projectPath);
     return project.absoluteDir().absoluteFilePath(project.completeBaseName() + QStringLiteral(".pproj"));
 }
