+/*
+    SPDX-FileCopyrightText: 2026 Erich Seifert <dev@erichseifert.de>
+
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "postprojectsidecar.h"
+#include "bin/binplaylist.hpp"
+#include "kdenlive_debug.h"
+#include "xml/xml.hpp"
+#include <config-kdenlive.h>
+
+#include <QDir>
+#include <QDomDocument>
+#include <QFileInfo>
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+// The PostProject C++ wrapper returns results instead of throwing, so this file
+// builds with Kdenlive's default -fno-exceptions. POSTPROJECT_TRY and
+// POSTPROJECT_TRY_ASSIGN return a failed result's error to the caller.
+#include <postproject/postproject.hpp>
+
+namespace pp = postproject;
+
+namespace {
+
+// Kdenlive's clip identity is stored as an application identifier on the asset.
+constexpr const char *IdentifierScheme = "https://postproject.org/id/application";
+constexpr const char *IdentifierQualifier = "org.kde.kdenlive:control_uuid";
+// Kdenlive's own clip hash (an MD5 over head and tail regions) is kept as a host
+// fingerprint next to PostProject's. PostProject stores it but never computes it.
+constexpr const char *KdenliveHashAlgorithm = "kdenlive-file-hash";
+constexpr std::uint16_t KdenliveHashVersion = 1;
+
+struct BinClip
+{
+    std::string controlUuid;
+    QString path;
+    QString name;
+    QByteArray hash;
+};
+
+std::string utf8(const QString &value)
+{
+    return value.toStdString();
+}
+
+QString fromUtf8(const std::string &value)
+{
+    return QString::fromStdString(value);
+}
+
+// Returns the locator PostProject records for an existing path, or an empty
+// string. Locators are compared only in PostProject's own spelling.
+std::string locatorFor(const QString &path)
+{
+    return pp::fileLocator(utf8(path)).value_or(std::string());
+}
+
+QString pathFor(const std::string &uri)
+{
+    return pp::locatorFilePath(uri).transform(fromUtf8).value_or(QString());
+}
+
+bool isInside(const QString &path, const QString &directory)
+{
+    return path == directory || path.startsWith(directory + QLatin1Char('/'));
+}
+
+void logFailure(const QString &sidecar, const char *action, const pp::Error &error)
+{
+    qCWarning(KDENLIVE_LOG) << "PostProject sidecar" << sidecar << action << ":" << fromUtf8(error.message());
+}
+
+std::vector<BinClip> fileBackedBinClips(const QString &projectPath, const QDomDocument &scene)
+{
+    const QDomElement mlt = scene.documentElement();
+    QString root = mlt.attribute(QStringLiteral("root"));
+    if (root.isEmpty()) {
+        root = QFileInfo(projectPath).absolutePath();
+    }
+    std::set<QString> binIds;
+    const QDomNodeList playlists = scene.elementsByTagName(QStringLiteral("playlist"));
+    for (int i = 0; i < playlists.count(); ++i) {
+        const QDomElement playlist = playlists.item(i).toElement();
+        if (playlist.attribute(QStringLiteral("id")) != BinPlaylist::binPlaylistId) {
+            continue;
+        }
+        const QDomNodeList entries = playlist.elementsByTagName(QStringLiteral("entry"));
+        for (int j = 0; j < entries.count(); ++j) {
+            binIds.insert(entries.item(j).toElement().attribute(QStringLiteral("producer")));
+        }
+    }
+
+    std::vector<BinClip> clips;
+    std::set<std::string> seen;
+    for (const QString &tag : {QStringLiteral("producer"), QStringLiteral("chain")}) {
+        const QDomNodeList elements = scene.elementsByTagName(tag);
+        for (int i = 0; i < elements.count(); ++i) {
+            const QDomElement element = elements.item(i).toElement();
+            if (binIds.count(element.attribute(QStringLiteral("id"))) == 0) {
+                continue;
+            }
+            const QString service = Xml::getXmlProperty(element, QStringLiteral("mlt_service"));
+            if (!service.startsWith(QLatin1String("avformat")) && service != QLatin1String("qimage") && service != QLatin1String("pixbuf")) {
+                continue;
+            }
+            const std::string controlUuid = utf8(Xml::getXmlProperty(element, QStringLiteral("kdenlive:control_uuid")));
+            if (controlUuid.empty() || !seen.insert(controlUuid).second) {
+                continue;
+            }
+            // With a proxy in use, resource names the proxy and originalurl the clip.
+            QString path = Xml::getXmlProperty(element, QStringLiteral("kdenlive:originalurl"));
+            if (path.isEmpty()) {
+                path = Xml::getXmlProperty(element, QStringLiteral("resource"));
+            }
+            // Image sequences and slideshows are patterns, not files.
+            if (path.isEmpty() || path.contains(QLatin1Char('%')) || path.contains(QLatin1String(".all."))) {
+                continue;
+            }
+            const QFileInfo file(QDir(root), path);
+            if (!file.isFile()) {
+                continue;
+            }
+            QString name = Xml::getXmlProperty(element, QStringLiteral("kdenlive:clipname"));
+            if (name.isEmpty()) {
+                name = file.fileName();
+            }
+            const QByteArray hash = QByteArray::fromHex(Xml::getXmlProperty(element, QStringLiteral("kdenlive:file_hash")).toLatin1());
+            clips.push_back({controlUuid, file.canonicalFilePath(), name, hash});
+        }
+    }
+    return clips;
+}
+
+// One lookup: the qualifier separates Kdenlive's identifiers from other hosts'.
+pp::Result<std::optional<pp::Uuid>> findClipAsset(const pp::Production &production, const std::string &controlUuid)
+{
+    POSTPROJECT_TRY_ASSIGN(const std::vector<pp::ObjectRef> objects, production.findByExternalIdentifier(IdentifierScheme, controlUuid, IdentifierQualifier));
+    for (const pp::ObjectRef &object : objects) {
+        if (object.kind == pp::ObjectKind::asset) {
+            return std::optional<pp::Uuid>(object.id);
+        }
+    }
+    return std::optional<pp::Uuid>();
+}
+
+// The clip's file: the original single-file representation created by import.
+std::optional<pp::Representation> clipRepresentation(std::vector<pp::Representation> representations)
+{
+    for (pp::Representation &representation : representations) {
+        if (representation.kind == pp::RepresentationKind::original && representation.structure_kind == pp::ContentStructureKind::single_resource &&
+            representation.resources.size() == 1) {
+            return std::move(representation);
+        }
+    }
+    return std::nullopt;
+}
+
+pp::Result<std::optional<pp::Representation>> clipRepresentation(const pp::Production &production, const pp::Uuid &assetId)
+{
+    POSTPROJECT_TRY_ASSIGN(std::vector<pp::Representation> representations, production.representations(assetId));
+    return clipRepresentation(std::move(representations));
+}
+
+bool hasKdenliveHash(const pp::Resource &resource, const QByteArray &hash)
+{
+    for (const pp::Fingerprint &fingerprint : resource.fingerprints) {
+        if (fingerprint.algorithm == KdenliveHashAlgorithm && fingerprint.version == KdenliveHashVersion) {
+            return QByteArray(reinterpret_cast<const char *>(fingerprint.value.data()), int(fingerprint.value.size())) == hash;
+        }
+    }
+    return false;
+}
+
+// Records new clips and relinks; returns whether anything was staged.
+pp::Result<bool> stageClips(const pp::Production &production, pp::Transaction &transaction, const std::vector<BinClip> &clips)
+{
+    bool changed = false;
+    for (const BinClip &clip : clips) {
+        POSTPROJECT_TRY_ASSIGN(const std::optional<pp::Uuid> assetId, findClipAsset(production, clip.controlUuid));
+        if (!assetId) {
+            POSTPROJECT_TRY_ASSIGN(const pp::Uuid imported, transaction.importMedia(utf8(clip.path), utf8(clip.name)));
+            POSTPROJECT_TRY(
+                transaction.addExternalIdentifier({pp::ObjectKind::asset, imported}, {IdentifierScheme, clip.controlUuid, std::string(IdentifierQualifier)}));
+            changed = true;
+            continue;
+        }
+        POSTPROJECT_TRY_ASSIGN(const std::optional<pp::Representation> representation, clipRepresentation(production, *assetId));
+        if (!representation) {
+            continue;
+        }
+        const pp::Resource &resource = representation->resources.front();
+        const std::string current = locatorFor(clip.path);
+        bool known = false;
+        for (const pp::Locator &locator : resource.locators) {
+            known = known || locator.uri == current;
+        }
+        if (!known && !current.empty()) {
+            // Kdenlive relinked the clip: record where it is now, and retire the
+            // former locations whose files are gone.
+            POSTPROJECT_TRY(transaction.confirmLocator(resource.id, current));
+            for (const pp::Locator &locator : resource.locators) {
+                if (!QFileInfo::exists(pathFor(locator.uri))) {
+                    POSTPROJECT_TRY(transaction.retireLocator(locator.id));
+                }
+            }
+            changed = true;
+        }
+    }
+    return changed;
+}
+
+// Keeps Kdenlive's own hash of each clip as a host fingerprint. Recording any
+// resource fingerprint leaves its representation pending recomputation, so the
+// clip's present content is observed in the same transaction.
+pp::Result<bool> stageKdenliveHashes(const pp::Production &production, pp::Transaction &transaction, const std::vector<BinClip> &clips)
+{
+    bool changed = false;
+    for (const BinClip &clip : clips) {
+        if (clip.hash.isEmpty()) {
+            continue;
+        }
+        POSTPROJECT_TRY_ASSIGN(const std::optional<pp::Uuid> assetId, findClipAsset(production, clip.controlUuid));
+        if (!assetId) {
+            continue;
+        }
+        POSTPROJECT_TRY_ASSIGN(const std::optional<pp::Representation> representation, clipRepresentation(production, *assetId));
+        if (!representation || hasKdenliveHash(representation->resources.front(), clip.hash)) {
+            continue;
+        }
+        const pp::Uuid resourceId = representation->resources.front().id;
+        POSTPROJECT_TRY(transaction.recordResourceFingerprint(
+            resourceId, {KdenliveHashAlgorithm, KdenliveHashVersion, std::vector<std::uint8_t>(clip.hash.cbegin(), clip.hash.cend())}));
+        POSTPROJECT_TRY(transaction.observeResourceContent(resourceId, utf8(clip.path)));
+        changed = true;
+    }
+    return changed;
+}
+
+pp::Result<void> recordClips(const QString &sidecar, const QString &projectPath, const std::vector<BinClip> &clips)
+{
+    POSTPROJECT_TRY_ASSIGN(pp::Production production, QFileInfo::exists(sidecar)
+                                                          ? pp::Production::open(utf8(sidecar))
+                                                          : pp::Production::create(utf8(sidecar), utf8(QFileInfo(projectPath).completeBaseName())));
+    const pp::RevisionContext context{pp::OriginIdentity{"Kdenlive", std::string(KDENLIVE_VERSION), std::nullopt}, std::string("Save project")};
+
+    // New clips must be committed before their resources can take a host hash.
+    for (const auto stage : {&stageClips, &stageKdenliveHashes}) {
+        POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, production.beginTransaction());
+        POSTPROJECT_TRY(transaction.setRevisionContext(context));
+        POSTPROJECT_TRY_ASSIGN(const bool changed, stage(production, transaction, clips));
+        POSTPROJECT_TRY(changed ? transaction.commit() : transaction.rollback());
+    }
+    return {};
+}
+
+// Resolves every clip recorded in the sidecar in one call, and maps each clip's
+// control UUID to the one file PostProject identifies as that clip.
+pp::Result<QHash<QString, QString>> locateClips(const QString &sidecar, const QString &projectPath)
+{
+    POSTPROJECT_TRY_ASSIGN(const pp::Production production, pp::Production::open(utf8(sidecar)));
+    POSTPROJECT_TRY_ASSIGN(const std::vector<pp::Asset> assets, production.assets());
+
+    // Search the project folder as it is now, and each former clip folder
+    // outside it that still exists on this machine. Search directories are
+    // never recorded in the sidecar.
+    const QString projectFolder = QFileInfo(projectPath).absoluteDir().canonicalPath();
+    std::set<QString> folders;
+    std::vector<pp::Uuid> assetIds;
+    std::map<std::pair<pp::Uuid::Bytes, pp::Uuid::Bytes>, QString> clipFor; // (asset, representation) -> control UUID
+    for (const pp::Asset &asset : assets) {
+        pp::Result<std::vector<pp::ExternalIdentifier>> identifiers = production.externalIdentifiers({pp::ObjectKind::asset, asset.id});
+        pp::Result<std::vector<pp::Representation>> representations = production.representations(asset.id);
+        if (!identifiers.has_value() || !representations.has_value()) {
+            continue;
+        }
+        QString controlUuid;
+        for (const pp::ExternalIdentifier &identifier : *identifiers) {
+            if (identifier.scheme == IdentifierScheme && identifier.qualifier == IdentifierQualifier) {
+                controlUuid = fromUtf8(identifier.value);
+            }
+        }
+        const std::optional<pp::Representation> representation = clipRepresentation(*std::move(representations));
+        if (controlUuid.isEmpty() || !representation) {
+            continue;
+        }
+        for (const pp::Locator &locator : representation->resources.front().locators) {
+            const QString folder = QFileInfo(pathFor(locator.uri)).absolutePath();
+            if (!folder.isEmpty() && !isInside(folder, projectFolder) && QFileInfo(folder).isDir()) {
+                folders.insert(folder);
+            }
+        }
+        assetIds.push_back(asset.id);
+        clipFor[{asset.id.bytes(), representation->id.bytes()}] = controlUuid;
+    }
+
+    POSTPROJECT_TRY_ASSIGN(auto options, pp::ResolutionOptions::create());
+    POSTPROJECT_TRY(options.addSearchDirectory(utf8(projectFolder)));
+    for (const QString &folder : folders) {
+        POSTPROJECT_TRY(options.addSearchDirectory(utf8(folder)));
+    }
+    // Every clip is resolved together, so each folder is scanned only once.
+    POSTPROJECT_TRY_ASSIGN(const std::vector<pp::RepresentationResolution> resolutions, production.resolveAssets(assetIds, options));
+    QHash<QString, QString> paths;
+    for (const pp::RepresentationResolution &resolution : resolutions) {
+        const auto clip = clipFor.find({resolution.asset_id.bytes(), resolution.representation_id.bytes()});
+        if (clip == clipFor.end() || resolution.resources.size() != 1) {
+            continue;
+        }
+        const pp::ResourceResolution &resource = resolution.resources.front();
+        const bool located = resource.state == pp::ResourceResolutionState::online_at_known_locator ||
+                             resource.state == pp::ResourceResolutionState::resolved_exact || resource.state == pp::ResourceResolutionState::resolved_probable;
+        if (located && resource.candidates.size() == 1) {
+            paths.insert(clip->second, pathFor(resource.candidates.front().uri));
+        }
+    }
+    return paths;
+}
+
+} // namespace
+
+QString PostProjectSidecar::sidecarPath(const QString &projectPath)
+{
+    const QFileInfo project(projectPath);
+    return project.absoluteDir().absoluteFilePath(project.completeBaseName() + QStringLiteral(".pproj"));
+}
+
+void PostProjectSidecar::recordProject(const QString &projectPath, const QDomDocument &scene)
+{
+    const QString path = sidecarPath(projectPath);
+    const std::vector<BinClip> clips = fileBackedBinClips(projectPath, scene);
+    if (clips.empty() && !QFileInfo::exists(path)) {
+        return;
+    }
+    const pp::Result<void> recorded = recordClips(path, projectPath, clips);
+    if (!recorded.has_value()) {
+        logFailure(path, "was not updated", recorded.error());
+    }
+}
+
+PostProjectSidecar::ClipLocator::ClipLocator(QString projectPath)
+    : m_projectPath(std::move(projectPath))
+{
+}
+
+QString PostProjectSidecar::ClipLocator::locate(const QString &controlUuid)
+{
+    if (!m_resolved) {
+        m_resolved = true;
+        resolveAll();
+    }
+    return m_located.value(controlUuid);
+}
+
+void PostProjectSidecar::ClipLocator::resolveAll()
+{
+    const QString path = sidecarPath(m_projectPath);
+    if (!QFileInfo::exists(path)) {
+        return;
+    }
+    pp::Result<QHash<QString, QString>> located = locateClips(path, m_projectPath);
+    if (!located.has_value()) {
+        logFailure(path, "could not locate clips", located.error());
+        return;
+    }
+    m_located = *std::move(located);
+}
