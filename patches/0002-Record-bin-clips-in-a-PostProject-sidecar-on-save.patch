diff --git a/src/doc/postprojectsidecar.cpp b/src/doc/postprojectsidecar.cpp
new file mode 100644
index 000000000..5ad98d650
--- /dev/null
+++ b/src/doc/postprojectsidecar.cpp
@@ -0,0 +1,287 @@
+/*
+    SPDX-FileCopyrightText: 2026 Erich Seifert <dev@erichseifert.de>
+
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "postprojectsidecar.h"
+#include "bin/binplaylist.hpp"
+#include "kdenlive_debug.h"
+#include "xml/xml.hpp"
+#include <config-kdenlive.h>
+
+#include <QCryptographicHash>
+#include <QDir>
+#include <QDomDocument>
+#include <QFileInfo>
+#include <QUrl>
+
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+// The PostProject C++ wrapper reports errors as exceptions, so this is the only
+// Kdenlive source file compiled with exceptions enabled. None escape it.
+#include <postproject/postproject.hpp>
+
+namespace pp = postproject;
+
+namespace {
+
+// Kdenlive's clip identity is stored as an application identifier on the asset.
+constexpr const char *IdentifierScheme = "https://postproject.org/id/application";
+constexpr const char *IdentifierQualifier = "org.kde.kdenlive:control_uuid";
+// The logical root for the project folder. Its directory is supplied on every
+// resolution, so a moved project keeps resolving under its new folder.
+constexpr const char *ProjectRoot = "kdenlive-project";
+// Clip folders outside the project folder become roots named from a digest of
+// their path and labelled with the path itself.
+constexpr const char *FolderRootPrefix = "kdenlive-folder-";
+
+struct BinClip
+{
+    std::string controlUuid;
+    QString path;
+    QString name;
+};
+
+std::string utf8(const QString &value)
+{
+    return value.toStdString();
+}
+
+QString fromUtf8(const std::string &value)
+{
+    return QString::fromStdString(value);
+}
+
+QString localPath(const std::string &uri)
+{
+    return QUrl(fromUtf8(uri)).toLocalFile();
+}
+
+bool isInside(const QString &path, const QString &directory)
+{
+    return path == directory || path.startsWith(directory + QLatin1Char('/'));
+}
+
+QString folderRootName(const QString &directory)
+{
+    const QByteArray digest = QCryptographicHash::hash(directory.toUtf8(), QCryptographicHash::Sha256).toHex();
+    return QLatin1String(FolderRootPrefix) + QString::fromLatin1(digest.left(16));
+}
+
+std::vector<BinClip> fileBackedBinClips(const QString &projectPath, const QDomDocument &scene)
+{
+    const QDomElement mlt = scene.documentElement();
+    QString root = mlt.attribute(QStringLiteral("root"));
+    if (root.isEmpty()) {
+        root = QFileInfo(projectPath).absolutePath();
+    }
+    std::set<QString> binIds;
+    const QDomNodeList playlists = scene.elementsByTagName(QStringLiteral("playlist"));
+    for (int i = 0; i < playlists.count(); ++i) {
+        const QDomElement playlist = playlists.item(i).toElement();
+        if (playlist.attribute(QStringLiteral("id")) != BinPlaylist::binPlaylistId) {
+            continue;
+        }
+        const QDomNodeList entries = playlist.elementsByTagName(QStringLiteral("entry"));
+        for (int j = 0; j < entries.count(); ++j) {
+            binIds.insert(entries.item(j).toElement().attribute(QStringLiteral("producer")));
+        }
+    }
+
+    std::vector<BinClip> clips;
+    std::set<std::string> seen;
+    for (const QString &tag : {QStringLiteral("producer"), QStringLiteral("chain")}) {
+        const QDomNodeList elements = scene.elementsByTagName(tag);
+        for (int i = 0; i < elements.count(); ++i) {
+            const QDomElement element = elements.item(i).toElement();
+            if (binIds.count(element.attribute(QStringLiteral("id"))) == 0) {
+                continue;
+            }
+            const QString service = Xml::getXmlProperty(element, QStringLiteral("mlt_service"));
+            if (!service.startsWith(QLatin1String("avformat")) && service != QLatin1String("qimage") && service != QLatin1String("pixbuf")) {
+                continue;
+            }
+            const std::string controlUuid = utf8(Xml::getXmlProperty(element, QStringLiteral("kdenlive:control_uuid")));
+            if (controlUuid.empty() || !seen.insert(controlUuid).second) {
+                continue;
+            }
+            // With a proxy in use, resource names the proxy and originalurl the clip.
+            QString path = Xml::getXmlProperty(element, QStringLiteral("kdenlive:originalurl"));
+            if (path.isEmpty()) {
+                path = Xml::getXmlProperty(element, QStringLiteral("resource"));
+            }
+            // Image sequences and slideshows are patterns, not files.
+            if (path.isEmpty() || path.contains(QLatin1Char('%')) || path.contains(QLatin1String(".all."))) {
+                continue;
+            }
+            const QFileInfo file(QDir(root), path);
+            if (!file.isFile()) {
+                continue;
+            }
+            QString name = Xml::getXmlProperty(element, QStringLiteral("kdenlive:clipname"));
+            if (name.isEmpty()) {
+                name = file.fileName();
+            }
+            clips.push_back({controlUuid, file.canonicalFilePath(), name});
+        }
+    }
+    return clips;
+}
+
+std::optional<pp::Uuid> findClipAsset(const pp::Production &production, const std::string &controlUuid)
+{
+    for (const pp::ObjectRef &object : production.findByExternalIdentifier(IdentifierScheme, controlUuid)) {
+        if (object.kind != pp::ObjectKind::asset) {
+            continue;
+        }
+        for (const pp::ExternalIdentifier &identifier : production.externalIdentifiers(object)) {
+            if (identifier.scheme == IdentifierScheme && identifier.value == controlUuid && identifier.qualifier == IdentifierQualifier) {
+                return object.id;
+            }
+        }
+    }
+    return std::nullopt;
+}
+
+// The clip's file: the original single-file representation created by import.
+std::optional<pp::Representation> clipRepresentation(const pp::Production &production, const pp::Uuid &assetId)
+{
+    for (pp::Representation &representation : production.representations(assetId)) {
+        if (representation.kind == pp::RepresentationKind::original && representation.structure_kind == pp::ContentStructureKind::single_resource &&
+            representation.resources.size() == 1) {
+            return std::move(representation);
+        }
+    }
+    return std::nullopt;
+}
+
+} // namespace
+
+QString PostProjectSidecar::sidecarPath(const QString &projectPath)
+{
+    const QFileInfo project(projectPath);
+    return project.absoluteDir().absoluteFilePath(project.completeBaseName() + QStringLiteral(".pproj"));
+}
+
+void PostProjectSidecar::recordProject(const QString &projectPath, const QDomDocument &scene)
+{
+    const QString path = sidecarPath(projectPath);
+    try {
+        const std::vector<BinClip> clips = fileBackedBinClips(projectPath, scene);
+        if (clips.empty() && !QFileInfo::exists(path)) {
+            return;
+        }
+        pp::Production production =
+            QFileInfo::exists(path) ? pp::Production::open(utf8(path)) : pp::Production::create(utf8(path), utf8(QFileInfo(projectPath).completeBaseName()));
+        const QString projectFolder = QFileInfo(projectPath).absoluteDir().canonicalPath();
+
+        std::set<QString> rootNames;
+        for (const pp::MediaRoot &root : production.mediaRoots()) {
+            rootNames.insert(fromUtf8(root.name));
+        }
+        pp::Transaction transaction = production.beginTransaction();
+        transaction.setRevisionContext({pp::OriginIdentity{"Kdenlive", std::string(KDENLIVE_VERSION), std::nullopt}, std::string("Save project")});
+        bool changed = false;
+        if (rootNames.insert(QLatin1String(ProjectRoot)).second) {
+            transaction.addMediaRoot(ProjectRoot, "Kdenlive project folder", 0);
+            changed = true;
+        }
+        for (const BinClip &clip : clips) {
+            const QString folder = QFileInfo(clip.path).absolutePath();
+            if (!isInside(folder, projectFolder)) {
+                const QString rootName = folderRootName(folder);
+                if (rootNames.insert(rootName).second) {
+                    transaction.addMediaRoot(utf8(rootName), utf8(folder), 1);
+                    changed = true;
+                }
+            }
+
+            const std::optional<pp::Uuid> assetId = findClipAsset(production, clip.controlUuid);
+            if (!assetId) {
+                const pp::Uuid imported = transaction.importMedia(utf8(clip.path), utf8(clip.name));
+                transaction.addExternalIdentifier({pp::ObjectKind::asset, imported}, {IdentifierScheme, clip.controlUuid, std::string(IdentifierQualifier)});
+                changed = true;
+                continue;
+            }
+            const std::optional<pp::Representation> representation = clipRepresentation(production, *assetId);
+            if (!representation) {
+                continue;
+            }
+            const pp::Resource &resource = representation->resources.front();
+            bool known = false;
+            for (const pp::Locator &locator : resource.locators) {
+                known = known || localPath(locator.uri) == clip.path;
+            }
+            if (!known) {
+                // Kdenlive relinked the clip: record where it is now.
+                transaction.confirmLocator(resource.id, utf8(QUrl::fromLocalFile(clip.path).toString(QUrl::FullyEncoded)));
+                changed = true;
+            }
+        }
+        if (changed) {
+            transaction.commit();
+        } else {
+            transaction.rollback();
+        }
+    } catch (const pp::Error &error) {
+        qCWarning(KDENLIVE_LOG) << "PostProject sidecar" << path << "was not updated:" << error.what();
+    }
+}
+
+QString PostProjectSidecar::locateMissingClip(const QString &projectPath, const QString &controlUuid)
+{
+    const QString path = sidecarPath(projectPath);
+    if (controlUuid.isEmpty() || !QFileInfo::exists(path)) {
+        return QString();
+    }
+    try {
+        const pp::Production production = pp::Production::open(utf8(path));
+        const std::optional<pp::Uuid> assetId = findClipAsset(production, utf8(controlUuid));
+        if (!assetId) {
+            return QString();
+        }
+        const std::optional<pp::Representation> representation = clipRepresentation(production, *assetId);
+        if (!representation) {
+            return QString();
+        }
+        const pp::Resource &resource = representation->resources.front();
+
+        // Search the project folder as it is now, and each former clip folder
+        // outside it that still exists on this machine.
+        std::vector<pp::MediaRootMapping> mappings{{ProjectRoot, utf8(QFileInfo(projectPath).absolutePath())}};
+        for (const pp::MediaRoot &root : production.mediaRoots()) {
+            if (!root.label || !fromUtf8(root.name).startsWith(QLatin1String(FolderRootPrefix))) {
+                continue;
+            }
+            const QString folder = fromUtf8(*root.label);
+            bool former = false;
+            for (const pp::Locator &locator : resource.locators) {
+                former = former || QFileInfo(localPath(locator.uri)).absolutePath() == folder;
+            }
+            if (former && QFileInfo(folder).isDir()) {
+                mappings.push_back({root.name, utf8(folder)});
+            }
+        }
+
+        for (const pp::RepresentationResolution &resolution : production.resolveAsset(*assetId, mappings)) {
+            if (resolution.representation_id != representation->id) {
+                continue;
+            }
+            for (const pp::ResourceResolution &resourceResolution : resolution.resources) {
+                const bool located = resourceResolution.state == pp::ResourceResolutionState::online_at_known_locator ||
+                                     resourceResolution.state == pp::ResourceResolutionState::resolved_exact ||
+                                     resourceResolution.state == pp::ResourceResolutionState::resolved_probable;
+                if (resourceResolution.resource_id == resource.id && located && resourceResolution.candidates.size() == 1) {
+                    return localPath(resourceResolution.candidates.front().uri);
+                }
+            }
+        }
+    } catch (const pp::Error &error) {
+        qCWarning(KDENLIVE_LOG) << "PostProject sidecar" << path << "could not locate clip" << controlUuid << ":" << error.what();
+    }
+    return QString();
+}
