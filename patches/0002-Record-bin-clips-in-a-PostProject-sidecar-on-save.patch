@@ -0,0 +1,68 @@
+/*
+    SPDX-FileCopyrightText: 2026 Erich Seifert <dev@erichseifert.de>
+
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QHash>
+#include <QString>
+
+class QDomDocument;
+
+/**
+ * @brief Experimental PostProject sidecar used to relink missing clips by content.
+ *
+ * A project saved as film.kdenlive keeps a PostProject production in film.pproj
+ * next to it. The project file stays authoritative and is never modified by this
+ * code: the sidecar only records each file-backed bin clip (keyed by its
+ * kdenlive:control_uuid) with PostProject's content fingerprint, Kdenlive's own
+ * clip hash, and the clip's location. When clips are missing, PostProject
+ * resolves them by content under the project folder and the clips' former
+ * folders. Every failure is logged and treated as "no answer", so Kdenlive
+ * behaves as without the sidecar.
+ *
+ * See https://github.com/postproject-org/postproject-kdenlive
+ */
+namespace PostProjectSidecar {
+
+/** @brief Returns the sidecar production path for a project file path. */
+QString sidecarPath(const QString &projectPath);
+
+/**
+ * @brief Records the saved project's file-backed bin clips in the sidecar.
+ *
+ * Creates the sidecar when the project has at least one such clip. Clips seen for
+ * the first time are imported and fingerprinted; a known clip whose file moved
+ * gets its new location confirmed and its vanished former locations retired.
+ */
+void recordProject(const QString &projectPath, const QDomDocument &scene);
+
+/**
+ * @brief Locates missing bin clips of one opened project by content.
+ *
+ * The first query resolves every clip recorded in the sidecar in a single
+ * PostProject call, so a project with many missing clips is searched once.
+ */
+class ClipLocator
+{
+public:
+    explicit ClipLocator(QString projectPath);
+
+    /**
+     * @returns the local path of the one file PostProject identifies as the clip,
+     *          or an empty string when the sidecar or clip is unknown, nothing
+     *          matches, or more than one file matches.
+     */
+    QString locate(const QString &controlUuid);
+
+private:
+    void resolveAll();
+
+    QString m_projectPath;
+    bool m_resolved = false;
+    QHash<QString, QString> m_located;
+};
+
+} // namespace PostProjectSidecar
