+#pragma once
+
+#include <QString>
+
+class QDomDocument;
+
+/**
+ * @brief Experimental PostProject sidecar used to relink missing clips by content.
+ *
+ * A project saved as film.kdenlive keeps a PostProject production in film.pproj
+ * next to it. The project file stays authoritative and is never modified by this
+ * code: the sidecar only records each file-backed bin clip (keyed by its
+ * kdenlive:control_uuid) with PostProject's content fingerprint and location.
+ * When a clip is missing, PostProject resolves it by content under the project
+ * folder and the clip's former folder. Every failure is logged and treated as
+ * "no answer", so Kdenlive behaves as without the sidecar.
+ *
+ * See https://github.com/postproject-org/postproject-kdenlive
+ */
+namespace PostProjectSidecar {
+
+/** @brief Returns the sidecar production path for a project file path. */
+QString sidecarPath(const QString &projectPath);
+
+/**
+ * @brief Records the saved project's file-backed bin clips in the sidecar.
+ *
+ * Creates the sidecar when the project has at least one such clip. Clips seen for
+ * the first time are imported and fingerprinted; a known clip whose file moved
+ * gets its new location confirmed.
+ */
+void recordProject(const QString &projectPath, const QDomDocument &scene);
+
+/**
+ * @brief Locates a missing bin clip by content.
+ *
+ * @returns the local path of the one file PostProject identifies as the clip,
+ *          or an empty string when the sidecar or clip is unknown, nothing
+ *          matches, or more than one file matches.
+ */
+QString locateMissingClip(const QString &projectPath, const QString &controlUuid);
+
+} // namespace PostProjectSidecar
