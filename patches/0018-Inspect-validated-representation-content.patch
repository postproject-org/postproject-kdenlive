Subject: [PATCH] refactor: Inspect validated representation content

---
 src/doc/postprojectsidecar.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/doc/postprojectsidecar.cpp b/src/doc/postprojectsidecar.cpp
index d5b24dc..6e88a8c 100644
--- a/src/doc/postprojectsidecar.cpp
+++ b/src/doc/postprojectsidecar.cpp
@@ -184,7 +184,7 @@ template <typename Reader> pp::Result<std::optional<pp::AssetId>> findClipAsset(
 std::optional<pp::Representation> clipRepresentation(std::vector<pp::Representation> representations)
 {
     for (pp::Representation &representation : representations) {
-        if (representation.kind == pp::RepresentationKind::original && representation.structure_kind == pp::ContentStructureKind::single_resource &&
+        if (representation.kind == pp::RepresentationKind::original && representation.structureKind() == pp::ContentStructureKind::single_resource &&
             representation.resources.size() == 1) {
             return std::move(representation);
         }
