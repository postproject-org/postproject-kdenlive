+bool PostProjectSidecar::isProxyStale(const QString &projectPath, const QString &controlUuid, const QString &sourcePath, const QString &proxyPath)
+{
+    const QString path = sidecarPath(projectPath);
+    if (controlUuid.isEmpty() || !QFileInfo::exists(path)) {
+        return false;
+    }
+    const pp::Result<bool> stale = proxyIsStale(path, utf8(controlUuid), sourcePath, proxyPath);
+    if (!stale.has_value()) {
+        logFailure(path, "could not evaluate a proxy", stale.error());
+        return false;
+    }
+    return *stale;
+}
