From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erich Seifert <dev@erichseifert.de>
Date: Mon, 5 Oct 2026 12:00:00 +0200
Subject: [PATCH 10/10] Carry scoped decision tokens through the shared workflow


diff --git a/tests/postprojecttest.cpp b/tests/postprojecttest.cpp
--- a/tests/postprojecttest.cpp
+++ b/tests/postprojecttest.cpp
@@ -371,22 +371,25 @@
     }
 
     if (action == QLatin1String("prepare-conflict")) {
-        const auto latest = production.latestRevision().value();
-        REQUIRE(latest.has_value());
-        QFile state(directory.filePath(QStringLiteral("base-sequence")));
+        const auto view = production.readSession().value();
+        const auto base = view.decisionBase().value();
+        REQUIRE(base.revision.has_value());
+        const auto token = QByteArray::fromStdString(base.toToken().value());
+        QFile state(directory.filePath(QStringLiteral("decision-base")));
         REQUIRE(state.open(QIODevice::WriteOnly | QIODevice::Truncate));
-        REQUIRE(state.write(QByteArray::number(latest->sequence)) > 0);
+        REQUIRE(state.write(token) == token.size());
         return;
     }
 
     if (action == QLatin1String("lose-conflict")) {
-        QFile state(directory.filePath(QStringLiteral("base-sequence")));
+        QFile state(directory.filePath(QStringLiteral("decision-base")));
         REQUIRE(state.open(QIODevice::ReadOnly));
-        const std::uint64_t baseSequence = state.readAll().toULongLong();
-        const auto revisions = production.changesSince(0).value();
-        const auto base = std::find_if(revisions.cbegin(), revisions.cend(),
-                                       [baseSequence](const postproject::Revision &revision) { return revision.sequence == baseSequence; });
-        REQUIRE(base != revisions.cend());
+        const auto token = state.read(129);
+        REQUIRE(token.size() <= 128);
+        const auto base = postproject::DecisionBase::fromToken(token.toStdString()).value();
+        REQUIRE(base.revision.has_value());
+        REQUIRE(base.production_id == production.id().value());
+        const auto baseSequence = base.revision->sequence;
         const auto latest = production.latestRevision().value();
         REQUIRE(latest.has_value());
         REQUIRE(latest->sequence > baseSequence);
@@ -397,12 +400,12 @@
         REQUIRE(original != representations.cend());
         const QString choice = directory.filePath(QStringLiteral("kdenlive-choice.mkv"));
         REQUIRE(QFile::copy(movedPath, choice));
-        auto transaction = production.beginTransaction(base->id).value();
+        auto transaction = production.edit(base).value();
         REQUIRE(transaction
                     .setRevisionContext({postproject::OriginIdentity{"Kdenlive", std::string("26.08.1"), std::nullopt}, std::string("Confirm source location")})
                     .has_value());
         REQUIRE(transaction.confirmLocator(original->resources.front().id, postproject::fileLocator(choice.toStdString()).value()).has_value());
-        const auto committed = transaction.commit();
+        const auto committed = transaction.commitWithReceipt();
         REQUIRE_FALSE(committed.has_value());
         const auto *conflict = committed.error().transactionConflict();
         REQUIRE(conflict != nullptr);
