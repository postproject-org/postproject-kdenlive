Subject: [PATCH] fix: read save decisions through the retained view

---
 src/doc/postprojectsidecar.cpp | 26 ++++++++++++++++--------
 tests/postprojecttest.cpp      | 37 ++++++++++++++++++++++++++++++++++
 2 files changed, 55 insertions(+), 8 deletions(-)

diff --git a/src/doc/postprojectsidecar.cpp b/src/doc/postprojectsidecar.cpp
index 647a81f..f453628 100644
--- a/src/doc/postprojectsidecar.cpp
+++ b/src/doc/postprojectsidecar.cpp
@@ -168,7 +168,7 @@ std::vector<BinClip> fileBackedBinClips(const QString &projectPath, const QDomDo
 }
 
 // One lookup: the qualifier separates Kdenlive's identifiers from other hosts'.
-pp::Result<std::optional<pp::AssetId>> findClipAsset(const pp::Production &production, const std::string &controlUuid)
+template <typename Reader> pp::Result<std::optional<pp::AssetId>> findClipAsset(const Reader &production, const std::string &controlUuid)
 {
     POSTPROJECT_TRY_ASSIGN(const std::vector<pp::ObjectRef> objects, production.findByExternalIdentifier(IdentifierScheme, controlUuid, IdentifierQualifier));
     for (const pp::ObjectRef &object : objects) {
@@ -191,9 +191,18 @@ std::optional<pp::Representation> clipRepresentation(std::vector<pp::Representat
     return std::nullopt;
 }
 
-pp::Result<std::optional<pp::Representation>> clipRepresentation(const pp::Production &production, const pp::AssetId &assetId)
+template <typename Reader> pp::Result<std::vector<pp::Representation>> representationsForClip(const Reader &production, const pp::AssetId &assetId)
 {
-    POSTPROJECT_TRY_ASSIGN(std::vector<pp::Representation> representations, production.representations(assetId));
+    POSTPROJECT_TRY_ASSIGN(auto page, production.representations(assetId, 1000));
+    if (page.next_cursor) {
+        return pp::Error(pp::ErrorCode::unsupported, "Clip has more than 1000 representations; refusing an incomplete decision");
+    }
+    return std::move(page.items);
+}
+
+template <typename Reader> pp::Result<std::optional<pp::Representation>> clipRepresentation(const Reader &production, const pp::AssetId &assetId)
+{
+    POSTPROJECT_TRY_ASSIGN(std::vector<pp::Representation> representations, representationsForClip(production, assetId));
     return clipRepresentation(std::move(representations));
 }
 
@@ -229,7 +238,7 @@ bool hasKdenliveHash(const pp::Resource &resource, const QByteArray &hash)
 }
 
 // Records new clips and relinks; returns whether anything was staged.
-pp::Result<bool> stageClips(const pp::Production &production, pp::Transaction &transaction, const std::vector<BinClip> &clips)
+pp::Result<bool> stageClips(const pp::ReadSession &production, pp::Transaction &transaction, const std::vector<BinClip> &clips)
 {
     bool changed = false;
     for (const BinClip &clip : clips) {
@@ -269,7 +278,7 @@ pp::Result<bool> stageClips(const pp::Production &production, pp::Transaction &t
 // Keeps Kdenlive's own hash of each clip as a host fingerprint. Recording any
 // resource fingerprint leaves its representation pending recomputation, so the
 // clip's present content is observed in the same transaction.
-pp::Result<bool> stageKdenliveHashes(const pp::Production &production, pp::Transaction &transaction, const std::vector<BinClip> &clips)
+pp::Result<bool> stageKdenliveHashes(const pp::ReadSession &production, pp::Transaction &transaction, const std::vector<BinClip> &clips)
 {
     bool changed = false;
     for (const BinClip &clip : clips) {
@@ -298,7 +307,7 @@ pp::Result<bool> stageKdenliveHashes(const pp::Production &production, pp::Trans
 // after its source's hash, so a proxy named after the clip's present hash was
 // made from the clip's present content. No render was observed, so the
 // activity names neither the tool nor its arguments.
-pp::Result<bool> stageAdoptedProxies(const pp::Production &production, pp::Transaction &transaction, const std::vector<BinClip> &clips)
+pp::Result<bool> stageAdoptedProxies(const pp::ReadSession &production, pp::Transaction &transaction, const std::vector<BinClip> &clips)
 {
     bool changed = false;
     for (const BinClip &clip : clips) {
@@ -309,7 +318,7 @@ pp::Result<bool> stageAdoptedProxies(const pp::Production &production, pp::Trans
         if (!assetId) {
             continue;
         }
-        POSTPROJECT_TRY_ASSIGN(const std::vector<pp::Representation> representations, production.representations(*assetId));
+        POSTPROJECT_TRY_ASSIGN(const std::vector<pp::Representation> representations, representationsForClip(production, *assetId));
         const std::optional<pp::Representation> source = clipRepresentation(representations);
         if (!source || proxyAt(representations, locatorFor(clip.proxy)) || ProjectClip::calculateHash(clip.path).first != clip.hash) {
             continue;
@@ -340,7 +349,8 @@ pp::Result<void> recordClips(const QString &sidecar, const QString &projectPath,
         POSTPROJECT_TRY_ASSIGN(pp::ReadSession view, production.readSession());
         POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, view.edit());
         POSTPROJECT_TRY(transaction.setRevisionContext(context));
-        POSTPROJECT_TRY_ASSIGN(const bool changed, stage(production, transaction, clips));
+        // The decisions and the edit base come from the same retained view.
+        POSTPROJECT_TRY_ASSIGN(const bool changed, stage(view, transaction, clips));
         POSTPROJECT_TRY(changed ? transaction.commit() : transaction.rollback());
     }
     return {};
diff --git a/tests/postprojecttest.cpp b/tests/postprojecttest.cpp
index 8f1aa05..b841529 100644
--- a/tests/postprojecttest.cpp
+++ b/tests/postprojecttest.cpp
@@ -135,6 +135,43 @@ std::vector<postproject::MetadataAssertion> recordedArguments(const postproject:
 
 } // namespace
 
+TEST_CASE("PostProject save refuses a truncated representation decision", "[PostProject]")
+{
+    QTemporaryDir project;
+    REQUIRE(project.isValid());
+    const QString source = project.filePath(QStringLiteral("clip.dat"));
+    const QString moved = project.filePath(QStringLiteral("moved.dat"));
+    const QString projectPath = project.filePath(QStringLiteral("film.kdenlive"));
+    QFile file(source);
+    REQUIRE(file.open(QIODevice::WriteOnly));
+    REQUIRE(file.write("bounded save fixture") == 20);
+    file.close();
+    const QString hash = kdenliveHash(source);
+    PostProjectSidecar::recordProject(projectPath, projectScene(project.path(), source, hash));
+    auto production = openSidecar(project.path());
+    const auto asset = clipAsset(production);
+    {
+        auto transaction = production.beginTransaction().value();
+        for (int i = 0; i < 1000; ++i) {
+            REQUIRE(transaction.addRepresentation(asset, postproject::RepresentationKind::proxy, source.toStdString()));
+        }
+        REQUIRE(transaction.commit());
+    }
+    const auto head = production.latestRevision().value();
+    REQUIRE(head);
+    const auto originalLocator = postproject::fileLocator(source.toStdString()).value();
+    REQUIRE(QFile::rename(source, moved));
+    PostProjectSidecar::recordProject(projectPath, projectScene(project.path(), moved, hash));
+    CHECK(production.latestRevision().value()->id == head->id);
+    const auto original = production.representations(asset).value();
+    const auto found =
+        std::find_if(original.begin(), original.end(), [](const auto &value) { return value.kind == postproject::RepresentationKind::original; });
+    REQUIRE(found != original.end());
+    REQUIRE(found->resources.size() == 1);
+    REQUIRE(found->resources.front().locators.size() == 1);
+    CHECK(found->resources.front().locators.front().uri == originalLocator);
+}
+
 TEST_CASE("Relink missing clips through a PostProject sidecar", "[PostProject]")
 {
     QTemporaryDir temporary;
