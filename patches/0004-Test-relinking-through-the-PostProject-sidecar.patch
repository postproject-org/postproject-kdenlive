+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+#include "test_utils.hpp"
+// test specific headers
+#include "bin/projectclip.h"
+#include "doc/documentchecker.h"
+#include "doc/postprojectsidecar.h"
+#include "xml/xml.hpp"
+
+#include <QTemporaryDir>
+#include <QUuid>
+
+#include <postproject/postproject.hpp>
+
+namespace {
+
+const QString ControlUuid = QUuid::createUuidV5(QUuid(), QStringLiteral("postproject-pilot")).toString();
+
+// A clip larger than 1 MiB, so PostProject identifies it by a sampled fingerprint.
+const QString ClipSource = sourcesPath + QStringLiteral("/dataset/lots_of_audio_streams.mkv");
+
+QString kdenliveHash(const QString &path)
+{
+    return QString::fromLatin1(ProjectClip::calculateHash(path).first.toHex());
+}
+
+// The saved form of a project with one bin clip, as Kdenlive writes it.
+QDomDocument projectScene(const QString &root, const QString &resource, const QString &hash)
+{
+    const QString xml = QStringLiteral(R"(<?xml version="1.0" encoding="utf-8"?>
+<mlt LC_NUMERIC="C" producer="main_bin" root="%1" version="7.40.0">
+ <chain id="chain0" out="100">
+  <property name="resource">%2</property>
+  <property name="mlt_service">avformat-novalidate</property>
+  <property name="kdenlive:id">2</property>
+  <property name="kdenlive:clipname">interview</property>
+  <property name="kdenlive:control_uuid">%3</property>
+  <property name="kdenlive:file_hash">%4</property>
+ </chain>
+ <playlist id="main_bin">
+  <property name="kdenlive:docproperties.documentid">1700000000000</property>
+  <entry in="0" out="100" producer="chain0"/>
+ </playlist>
+</mlt>
+)")
+                            .arg(root, resource, ControlUuid, hash);
+    QDomDocument doc;
+    REQUIRE(doc.setContent(xml));
+    return doc;
+}
+
+// The clip's resource as the sidecar records it, found by Kdenlive's identity.
+postproject::Resource recordedResource(const QString &projectFolder)
+{
+    const auto production = postproject::Production::open(QString(projectFolder + QStringLiteral("/film.pproj")).toStdString()).value();
+    const auto assets =
+        production.findByExternalIdentifier("https://postproject.org/id/application", ControlUuid.toStdString(), "org.kde.kdenlive:control_uuid").value();
+    REQUIRE(assets.size() == 1);
+    const auto representations = production.representations(assets.front().id).value();
+    REQUIRE(representations.size() == 1);
+    REQUIRE(representations.front().resources.size() == 1);
+    return representations.front().resources.front();
+}
+
+QStringList recordedLocators(const QString &projectFolder)
+{
+    QStringList locators;
+    for (const auto &locator : recordedResource(projectFolder).locators) {
+        locators << QString::fromStdString(postproject::locatorFilePath(locator.uri).value());
+    }
+    return locators;
+}
+
+// Opens the project as Kdenlive does and returns the missing-clip entry.
+DocumentChecker::DocumentResource checkMissingClip(const QString &projectPath, QDomDocument &doc)
+{
+    DocumentChecker checker(QUrl::fromLocalFile(projectPath), doc);
+    REQUIRE(checker.hasErrorInProject());
+    for (const auto &item : checker.resourceItems()) {
+        if (item.type == DocumentChecker::MissingType::Clip) {
+            KdenliveTests::applyDocumentCheckerFixes(checker);
+            return item;
+        }
+    }
+    FAIL("no missing clip reported");
+    return {};
+}
+
+} // namespace
+
+TEST_CASE("Relink missing clips through a PostProject sidecar", "[PostProject]")
+{
+    QTemporaryDir temporary;
+    REQUIRE(temporary.isValid());
+    QDir base(temporary.path());
+    REQUIRE(base.mkpath(QStringLiteral("film/rushes")));
+    REQUIRE(base.mkpath(QStringLiteral("film/other")));
+    const QString projectFolder = QDir(base.filePath(QStringLiteral("film"))).canonicalPath();
+    const QString projectPath = projectFolder + QStringLiteral("/film.kdenlive");
+    const QString clipPath = projectFolder + QStringLiteral("/rushes/interview.mkv");
+    REQUIRE(QFile::copy(ClipSource, clipPath));
+    const QString hash = kdenliveHash(clipPath);
+
+    SECTION("Saving records the clip and a renamed clip is relinked by content")
+    {
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash));
+        REQUIRE(QFile::exists(projectFolder + QStringLiteral("/film.pproj")));
+
+        const QString renamed = projectFolder + QStringLiteral("/rushes/interview-take2.mkv");
+        REQUIRE(QFile::rename(clipPath, renamed));
+        // Same name, different content: filename evidence alone must not win.
+        REQUIRE(QFile::copy(sourcesPath + QStringLiteral("/dataset/red.mp4"), projectFolder + QStringLiteral("/other/interview.mkv")));
+
+        QDomDocument doc = projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash);
+        const auto item = checkMissingClip(projectPath, doc);
+        CHECK(item.status == DocumentChecker::MissingStatus::Fixed);
+        CHECK(item.newFilePath == renamed);
+        const QDomElement chain = doc.elementsByTagName(QStringLiteral("chain")).item(0).toElement();
+        CHECK(Xml::getXmlProperty(chain, QStringLiteral("resource")) == renamed);
+    }
+
+    SECTION("Saving after a relink confirms the new location and retires the old one")
+    {
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash));
+        const QString moved = projectFolder + QStringLiteral("/other/interview.mkv");
+        REQUIRE(QFile::rename(clipPath, moved));
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, moved, hash));
+
+        const QStringList locators = recordedLocators(projectFolder);
+        CHECK(locators == QStringList({moved}));
+    }
+
+    SECTION("A former location whose file still exists is kept")
+    {
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash));
+        const QString copy = projectFolder + QStringLiteral("/other/interview.mkv");
+        REQUIRE(QFile::copy(clipPath, copy));
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, copy, hash));
+
+        QStringList locators = recordedLocators(projectFolder);
+        locators.sort();
+        CHECK(locators == QStringList({copy, clipPath}));
+    }
+
+    SECTION("A clip outside the project folder is found in its former folder")
+    {
+        REQUIRE(base.mkpath(QStringLiteral("media")));
+        const QString mediaFolder = QDir(base.filePath(QStringLiteral("media"))).canonicalPath();
+        const QString outside = mediaFolder + QStringLiteral("/interview.mkv");
+        REQUIRE(QFile::rename(clipPath, outside));
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, outside, hash));
+        const QString renamed = mediaFolder + QStringLiteral("/interview-graded.mkv");
+        REQUIRE(QFile::rename(outside, renamed));
+
+        QDomDocument doc = projectScene(projectFolder, outside, hash);
+        const auto item = checkMissingClip(projectPath, doc);
+        CHECK(item.status == DocumentChecker::MissingStatus::Fixed);
+        CHECK(item.newFilePath == renamed);
+    }
+
+    SECTION("The sidecar keeps Kdenlive's hash and records no roots or paths of its own")
+    {
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash));
+
+        const auto resource = recordedResource(projectFolder);
+        bool kdenliveHash = false;
+        for (const auto &fingerprint : resource.fingerprints) {
+            kdenliveHash = kdenliveHash ||
+                           (fingerprint.algorithm == "kdenlive-file-hash" &&
+                            QByteArray(reinterpret_cast<const char *>(fingerprint.value.data()), int(fingerprint.value.size())).toHex() == hash.toLatin1());
+        }
+        CHECK(kdenliveHash);
+        const auto production = postproject::Production::open(QString(projectFolder + QStringLiteral("/film.pproj")).toStdString()).value();
+        CHECK(production.mediaRoots().value().empty());
+        // The host hash was recorded together with a recomputed representation
+        // fingerprint, so no representation is left pending recomputation.
+        const auto latest = production.latestRevision().value();
+        REQUIRE(latest.has_value());
+        bool recomputed = false;
+        for (const auto &event : production.revisionEvents(latest->id).value()) {
+            recomputed = recomputed || std::holds_alternative<postproject::RepresentationFingerprintObservedEvent>(event.payload);
+        }
+        CHECK(recomputed);
+    }
+
+    SECTION("Several missing clips are located from one resolution")
+    {
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash));
+        const QString renamed = projectFolder + QStringLiteral("/other/interview-take2.mkv");
+        REQUIRE(QFile::rename(clipPath, renamed));
+
+        PostProjectSidecar::ClipLocator locator(projectPath);
+        CHECK(locator.locate(ControlUuid) == renamed);
+        // A later question is answered without searching again.
+        REQUIRE(QFile::remove(renamed));
+        CHECK(locator.locate(ControlUuid) == renamed);
+        CHECK(locator.locate(QStringLiteral("unknown")).isEmpty());
+    }
+
+    SECTION("Two identical copies stay for the user to choose")
+    {
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash));
+        REQUIRE(QFile::rename(clipPath, projectFolder + QStringLiteral("/rushes/a.mkv")));
+        REQUIRE(QFile::copy(projectFolder + QStringLiteral("/rushes/a.mkv"), projectFolder + QStringLiteral("/other/b.mkv")));
+
+        QDomDocument doc = projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash);
+        const auto item = checkMissingClip(projectPath, doc);
+        CHECK(item.status == DocumentChecker::MissingStatus::Missing);
+        CHECK(item.newFilePath.isEmpty());
+    }
+
+    SECTION("A candidate that Kdenlive's own hash rejects is not used")
+    {
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash));
+        REQUIRE(QFile::rename(clipPath, projectFolder + QStringLiteral("/rushes/interview-take2.mkv")));
+
+        QDomDocument doc = projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), QStringLiteral("00000000000000000000000000000000"));
+        const auto item = checkMissingClip(projectPath, doc);
+        CHECK(item.status == DocumentChecker::MissingStatus::Missing);
+    }
+
+    SECTION("Without a sidecar Kdenlive reports the clip as missing, as before")
+    {
+        REQUIRE(QFile::rename(clipPath, projectFolder + QStringLiteral("/rushes/interview-take2.mkv")));
+
+        QDomDocument doc = projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash);
+        const auto item = checkMissingClip(projectPath, doc);
+        CHECK(item.status == DocumentChecker::MissingStatus::Missing);
+        CHECK_FALSE(QFile::exists(projectFolder + QStringLiteral("/film.pproj")));
+    }
+
+    SECTION("An unreadable sidecar is ignored")
+    {
+        QFile corrupt(projectFolder + QStringLiteral("/film.pproj"));
+        REQUIRE(corrupt.open(QIODevice::WriteOnly));
+        corrupt.write("not a production");
+        corrupt.close();
+        PostProjectSidecar::recordProject(projectPath, projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash));
+        REQUIRE(QFile::rename(clipPath, projectFolder + QStringLiteral("/rushes/interview-take2.mkv")));
+
+        QDomDocument doc = projectScene(projectFolder, QStringLiteral("rushes/interview.mkv"), hash);
+        const auto item = checkMissingClip(projectPath, doc);
+        CHECK(item.status == DocumentChecker::MissingStatus::Missing);
+    }
+}
