     return DocumentChecker::isMltBuildInLuma(lumaName);
 }
 
+void KdenliveTests::applyDocumentCheckerFixes(DocumentChecker &checker)
+{
+    const QDomNodeList producers = checker.m_doc.elementsByTagName(QStringLiteral("producer"));
+    const QDomNodeList chains = checker.m_doc.elementsByTagName(QStringLiteral("chain"));
+    const QDomNodeList transitions = checker.m_doc.elementsByTagName(QStringLiteral("transition"));
+    const QDomNodeList filters = checker.m_doc.elementsByTagName(QStringLiteral("filter"));
+    for (const auto &item : checker.m_items) {
+        checker.fixMissingItem(item, producers, chains, transitions, filters);
+    }
+}
+
 void KdenliveTests::setAudioTargets(std::shared_ptr<TimelineItemModel> timeline, QMap<int, QString> audioInfo)
 {
     timeline->m_binAudioTargets = audioInfo;
