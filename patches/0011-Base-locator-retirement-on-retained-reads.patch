From 11a5a20d61765b8003acb64e9ade8bbf161b124c Mon Sep 17 00:00:00 2001
From: PostProject <dev@postproject.org>
Date: Tue, 6 Oct 2026 16:10:51 +0200
Subject: [PATCH] fix: base locator retirement on retained reads

---
 src/doc/postprojectsidecar.cpp | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/doc/postprojectsidecar.cpp b/src/doc/postprojectsidecar.cpp
index d08fe54..ffee210 100644
--- a/src/doc/postprojectsidecar.cpp
+++ b/src/doc/postprojectsidecar.cpp
@@ -337,7 +337,8 @@ pp::Result<void> recordClips(const QString &sidecar, const QString &projectPath,
     // New clips must be committed before their resources can take a host hash
     // or their proxies can be recorded.
     for (const auto stage : {&stageClips, &stageKdenliveHashes, &stageAdoptedProxies}) {
-        POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, production.beginTransaction());
+        POSTPROJECT_TRY_ASSIGN(pp::ReadSession view, production.readSession());
+        POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, view.edit());
         POSTPROJECT_TRY(transaction.setRevisionContext(context));
         POSTPROJECT_TRY_ASSIGN(const bool changed, stage(production, transaction, clips));
         POSTPROJECT_TRY(changed ? transaction.commit() : transaction.rollback());
@@ -620,9 +621,17 @@ void PostProjectSidecar::ProxyJob::succeed(const QString &proxyPath, const QStri
     Claim &claim = *m_claim;
     const pp::Result<void> completed = [&]() -> pp::Result<void> {
         const std::string proxyLocator = locatorFor(proxyPath);
-        POSTPROJECT_TRY_ASSIGN(const std::vector<pp::Representation> representations, claim.production.representations(claim.assetId));
+        POSTPROJECT_TRY_ASSIGN(pp::ReadSession view, claim.production.readSession());
+        std::vector<pp::Representation> representations;
+        std::optional<std::string> cursor;
+        do {
+            POSTPROJECT_TRY_ASSIGN(pp::QueryPage<pp::Representation> page,
+                                   view.representations(claim.assetId, 256, cursor ? std::optional<std::string_view>(*cursor) : std::nullopt));
+            representations.insert(representations.end(), page.items.begin(), page.items.end());
+            cursor = page.next_cursor;
+        } while (cursor);
         const std::int64_t now = nowMicros();
-        POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, claim.production.beginTransaction());
+        POSTPROJECT_TRY_ASSIGN(pp::Transaction transaction, view.edit());
         POSTPROJECT_TRY(transaction.setRevisionContext(revisionContext("Create proxy clip")));
         // A proxy rendered over an older one: the older proxy's content is gone.
         for (const pp::Representation &representation : representations) {
-- 
