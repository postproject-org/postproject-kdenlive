From: Erich Seifert <dev@erichseifert.de>
Date: Sun, 27 Sep 2026 14:34:34 +0200
Subject: [PATCH 3/4] Relink missing clips through the PostProject sidecar

When a bin clip is missing and the project root did not simply move,
ask the sidecar to resolve the clip by content under the project folder
and the clip's former folder. A single candidate whose Kdenlive hash
matches kdenlive:file_hash is offered as fixed in the relink dialog;
anything else leaves the clip missing, as before.

diff --git a/src/doc/documentchecker.cpp b/src/doc/documentchecker.cpp
index ac43ef4b3..7b7a25979 100644
--- a/src/doc/documentchecker.cpp
+++ b/src/doc/documentchecker.cpp
@@ -12,6 +12,10 @@
 #include "titler/titlewidget.h"
 #include "transitions/transitionsrepository.hpp"
 #include "xml/xml.hpp"
+#include <config-kdenlive.h>
+#ifdef HAVE_POSTPROJECT
+#include "postprojectsidecar.h"
+#endif
 
 #include <KLocalizedString>
 #include <KUrlRequester>
@@ -54,6 +58,20 @@ static bool isPlatformRelative(QString filePath, bool *platformChange)
     return true;
 }
 
+#ifdef HAVE_POSTPROJECT
+// Asks the project's PostProject sidecar where a missing clip went. The answer is
+// used only when Kdenlive's own hash of that file agrees with the stored one.
+static QString locateWithPostProject(const QUrl &projectUrl, const QDomElement &producer, const QString &hash)
+{
+    const QString located =
+        PostProjectSidecar::locateMissingClip(projectUrl.toLocalFile(), Xml::getXmlProperty(producer, QStringLiteral("kdenlive:control_uuid")));
+    if (located.isEmpty() || (!hash.isEmpty() && ProjectClip::calculateHash(located).first.toHex() != hash.toLatin1())) {
+        return QString();
+    }
+    return located;
+}
+#endif
+
 DocumentChecker::DocumentChecker(QUrl url, const QDomDocument &doc)
     : m_url(std::move(url))
     , m_doc(doc)
@@ -987,6 +1005,15 @@ QString DocumentChecker::getMissingProducers(QDomElement &e, const QDomNodeList
                 item.newFilePath = relocated;
                 item.status = MissingStatus::Fixed;
             }
+#ifdef HAVE_POSTPROJECT
+            if (item.status == MissingStatus::Missing && clipType != ClipType::SlideShow) {
+                const QString located = locateWithPostProject(m_url, e, item.hash);
+                if (!located.isEmpty()) {
+                    item.newFilePath = located;
+                    item.status = MissingStatus::Fixed;
+                }
+            }
+#endif
             m_items.push_back(item);
         }
     };
@@ -1070,6 +1097,15 @@ QString DocumentChecker::getMissingProducers(QDomElement &e, const QDomNodeList
                 item.hash = Xml::getXmlProperty(e, QStringLiteral("kdenlive:file_hash"));
                 item.fileSize = Xml::getXmlProperty(e, QStringLiteral("kdenlive:file_size"));
                 // item.mltService = Xml::getXmlProperty(e, QStringLiteral("mlt_service"));
+#ifdef HAVE_POSTPROJECT
+                if (!slideshow) {
+                    const QString located = locateWithPostProject(m_url, e, item.hash);
+                    if (!located.isEmpty()) {
+                        item.newFilePath = located;
+                        item.status = MissingStatus::Fixed;
+                    }
+                }
+#endif
             }
             m_items.push_back(item);
         } else if (!proxyFound) {
