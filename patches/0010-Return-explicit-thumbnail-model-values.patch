From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erich Seifert <dev@erichseifert.de>
Date: Thu, 1 Oct 2026 01:27:45 +0200
Subject: [PATCH 10/10] Return explicit thumbnail model values


diff --git a/src/timeline2/view/qml/ClipThumbs.qml b/src/timeline2/view/qml/ClipThumbs.qml
index e990ec3aa..b69a3fd9c 100644
--- a/src/timeline2/view/qml/ClipThumbs.qml
+++ b/src/timeline2/view/qml/ClipThumbs.qml
@@ -30,29 +30,23 @@ Row {
         id: thumbRepeater
         // switching the model allows one to have different view modes.
         // We set the model to the number of frames we want to show
-        model: switch (parentTrack.trackThumbsFormat) {
-                   case 0:
-                       // in/out
-                       if (parent.width > thumbRow.thumbWidth) {
-                           2 // 2: will display start / end thumbs
-                       } else {
-                           1 // 1: if the width of the container is to small, only show first thumbnail
-                       }
-                       break;
-                   case 1:
-                       // All frames
-                       // display as many thumbnails as can fit into the container
-                       Math.ceil(parent.width / thumbRow.thumbWidth)
-                       break;
-                   case 2:
-                       // In frame only
-                       1 // 1: only show first thumbnail
-                       break;
-                   case 3:
-                   default:
-                       // No thumbs
-                       0 // 0: will disable thumbnails
-               }
+        model: {
+            switch (parentTrack.trackThumbsFormat) {
+            case 0:
+                // In/out; narrow clips show only the first thumbnail.
+                return parent.width > thumbRow.thumbWidth ? 2 : 1;
+            case 1:
+                // All frames: as many thumbnails as fit in the container.
+                return Math.ceil(parent.width / thumbRow.thumbWidth);
+            case 2:
+                // In frame only.
+                return 1;
+            case 3:
+            default:
+                // No thumbnails.
+                return 0;
+            }
+        }
         property int startFrame: thumbRow.parentClip.inPoint
         property int endFrame: thumbRow.parentClip.outPoint
         property real imageWidth: Math.max(thumbRow.thumbWidth, parent.width / thumbRepeater.count)
