From 86e9ecc64982dfd68059c756eb0db3df688f1685 Mon Sep 17 00:00:00 2001
From: Erich Seifert <dev@erichseifert.de>
Date: Wed, 7 Oct 2026 16:34:23 +0200
Subject: [PATCH] Use point reads after the representation convenience bound

---
 tests/postprojecttest.cpp | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/tests/postprojecttest.cpp b/tests/postprojecttest.cpp
index b841529..8ce696e 100644
--- a/tests/postprojecttest.cpp
+++ b/tests/postprojecttest.cpp
@@ -150,6 +150,9 @@ TEST_CASE("PostProject save refuses a truncated representation decision", "[Post
     PostProjectSidecar::recordProject(projectPath, projectScene(project.path(), source, hash));
     auto production = openSidecar(project.path());
     const auto asset = clipAsset(production);
+    const auto initial = production.representations(asset).value();
+    REQUIRE(initial.size() == 1);
+    const auto originalId = initial.front().id;
     {
         auto transaction = production.beginTransaction().value();
         for (int i = 0; i < 1000; ++i) {
@@ -163,13 +166,13 @@ TEST_CASE("PostProject save refuses a truncated representation decision", "[Post
     REQUIRE(QFile::rename(source, moved));
     PostProjectSidecar::recordProject(projectPath, projectScene(project.path(), moved, hash));
     CHECK(production.latestRevision().value()->id == head->id);
-    const auto original = production.representations(asset).value();
-    const auto found =
-        std::find_if(original.begin(), original.end(), [](const auto &value) { return value.kind == postproject::RepresentationKind::original; });
-    REQUIRE(found != original.end());
-    REQUIRE(found->resources.size() == 1);
-    REQUIRE(found->resources.front().locators.size() == 1);
-    CHECK(found->resources.front().locators.front().uri == originalLocator);
+    const auto collection = production.representations(asset);
+    REQUIRE_FALSE(collection);
+    CHECK(collection.error().code() == postproject::ErrorCode::unsupported);
+    const auto original = production.representation(originalId).value();
+    REQUIRE(original.resources.size() == 1);
+    REQUIRE(original.resources.front().locators.size() == 1);
+    CHECK(original.resources.front().locators.front().uri == originalLocator);
 }
 
 TEST_CASE("Relink missing clips through a PostProject sidecar", "[PostProject]")
