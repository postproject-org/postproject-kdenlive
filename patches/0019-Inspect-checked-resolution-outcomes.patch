From f172c2a66901d40425e071a70b03ef899c33c547 Mon Sep 17 00:00:00 2001
From: Erich Seifert <dev@erichseifert.de>
Date: Thu, 8 Oct 2026 03:07:44 +0200
Subject: [PATCH] Inspect checked resolution outcomes

---
 src/doc/postprojectsidecar.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/doc/postprojectsidecar.cpp b/src/doc/postprojectsidecar.cpp
index 6e88a8c..744dcba 100644
--- a/src/doc/postprojectsidecar.cpp
+++ b/src/doc/postprojectsidecar.cpp
@@ -415,10 +415,10 @@ pp::Result<QHash<QString, QString>> locateClips(const QString &sidecar, const QS
             continue;
         }
         const pp::ResourceResolution &resource = resolution.resources.front();
-        const bool located = resource.state == pp::ResourceResolutionState::online_at_known_locator ||
-                             resource.state == pp::ResourceResolutionState::resolved_exact || resource.state == pp::ResourceResolutionState::resolved_probable;
-        if (located && resource.candidates.size() == 1) {
-            paths.insert(clip->second, pathFor(resource.candidates.front().uri));
+        const bool located = resource.state() == pp::ResourceResolutionState::online_at_known_locator ||
+                             resource.state() == pp::ResourceResolutionState::resolved_exact || resource.state() == pp::ResourceResolutionState::resolved_probable;
+        if (located && resource.candidates().size() == 1) {
+            paths.insert(clip->second, pathFor(resource.candidates().front().uri));
         }
     }
     return paths;
